{
    "name": "oleksyuk/apaleo-php",
    "description": "Framework-agnostic PHP SDK for the Apaleo hotel PMS API",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "apaleo",
        "apaleo-api",
        "hotel",
        "pms",
        "api-client",
        "sdk"
    ],
    "authors": [
        {
            "name": "Maks Oleksyuk",
            "email": "maksym.oleksyuk@gmail.com",
            "homepage": "https://github.com/maks-oleksyuk",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/maks-oleksyuk/apaleo-php",
    "support": {
        "issues": "https://github.com/maks-oleksyuk/apaleo-php/issues",
        "source": "https://github.com/maks-oleksyuk/apaleo-php"
    },
    "require": {
        "php": "^8.4",
        "ext-mbstring": "*",
        "php-http/discovery": "^1.20",
        "psr/clock": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/simple-cache": "^3.0",
        "symfony/http-client-contracts": "^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95.27",
        "nyholm/psr7": "^1.8.2",
        "php-http/mock-client": "^1.6.1",
        "phpstan/phpstan": "^2.2.14",
        "phpunit/phpunit": "^13.3.4",
        "rector/rector": "^2.6.7",
        "symfony/clock": "^8.0",
        "symfony/http-client": "^8.0"
    },
    "suggest": {
        "symfony/http-client": "Lets RequestPipeline::sendMany() dispatch requests concurrently instead of one by one."
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Oleksyuk\\Apaleo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Oleksyuk\\Apaleo\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "sort-packages": true
    }
}
